# ── Safe Repair Agent — environment template ────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# NEVER commit real keys.

# 1) Model endpoints for hosted probes (Scenario 3+), any OpenAI-compatible API:
#      Gemini: https://generativelanguage.googleapis.com/v1beta/openai  (key: https://aistudio.google.com/apikey)
#      Groq:   https://api.groq.com/openai/v1                           (key: https://console.groq.com/keys)
# EVAL_BASE_URL=
# EVAL_MODEL=
# EVAL_API_KEY=

# 2) Cloud sandbox for executing untrusted model repairs (grading step).
#    When present, the grader runs repairs inside an isolated cloud sandbox;
#    when absent, repairs stay "not executed" (the honest posture).
#    Daytona key: https://app.daytona.io/api
# DAYTONA_API_KEY=

# 3) Alternative sandbox provider (either one works; the adapter auto-detects):
# E2B_API_KEY=

# 4) Hosted model providers (Scenario 3+) - dashboard reads these from .env:
# GEMINI_API_KEY=      (https://aistudio.google.com/apikey)
# GROQ_API_KEY=        (https://console.groq.com/keys)
# NEBIUS_API_KEY=      (https://studio.nebius.ai)
# OPENROUTER_API_KEY=  (https://openrouter.ai/keys)
